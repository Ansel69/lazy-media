# Copy to .env and adjust. `.env` is gitignored; this template is not.
#
#   Copy-Item .env.example .env
#
# Every value below is for local development only. Nothing here reaches the
# static export: the export is HTML, CSS and images, and carries no server
# configuration with it.

SITE_PORT=8080

DB_NAME=lazy_media
DB_USER=lazymedia
DB_PASSWORD=change_me_locally
DB_ROOT_PASSWORD=change_me_locally

WP_URL=http://localhost:8080
WP_TITLE=Lazy Media
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change_me_before_first_login
WP_ADMIN_EMAIL=admin@example.com

# Production origin of the static export (no trailing slash). Used for
# canonical, Open Graph, JSON-LD, share links and sitemap URLs.
#
# Set this to the real deployment URL before exporting, or leave it empty to
# emit root-relative URLs instead.
#
# Examples:
#   LM_PUBLIC_URL=https://lazy-media-five.vercel.app
#   LM_PUBLIC_URL=
#
# lazy-media.vercel.app belongs to another account, which is why this project
# is aliased to lazy-media-five.vercel.app.
LM_PUBLIC_URL=https://lazy-media-five.vercel.app
